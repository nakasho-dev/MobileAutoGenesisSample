{
  "servers": {
    "auto-genesis-mcp-android": {
      "command": "${workspaceFolder}/scripts/autogenesis/start-mcp.sh",
      "args": [
        "android"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "LANG": "en_US.UTF-8",
        "LC_ALL": "en_US.UTF-8"
      }
    },
    "auto-genesis-mcp-ios": {
      "command": "${workspaceFolder}/scripts/autogenesis/start-mcp.sh",
      "args": [
        "ios"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "LANG": "en_US.UTF-8",
        "LC_ALL": "en_US.UTF-8"
      }
    }
  }
}
